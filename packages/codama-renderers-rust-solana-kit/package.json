{
  "name": "codama-renderers-rust-solana-kit",
  "version": "0.1.0",
  "description": "Codama renderer for off-chain Rust clients using Solana Kit",
  "license": "Unlicense",
  "repository": "https://github.com/pina-rs/solana_kit/tree/main/packages/codama-renderers-rust-solana-kit",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "engine/renderer.wasm",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-engine.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/test/*.test.js",
    "check:package": "node scripts/check-package.ts",
    "format:dist": "node scripts/format-dist.ts",
    "prepack": "npm run build && npm run format:dist && npm run check:package",
    "test:packed": "node scripts/test-packed.ts"
  },
  "dependencies": {
    "@codama/fragments": "0.1.5",
    "@codama/nodes": "1.10.2",
    "@codama/visitors-core": "1.10.2"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.5",
    "@types/node": "26.5.1",
    "codama": "1.10.2",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
